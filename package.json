{
  "name": "@morainet/geocompare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React components for comparing geospatial map layers",
  "license": "MIT",
  "files": [
    "dist",
    "docs"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite --config examples/demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config examples/demo/vite.config.ts",
    "test:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:package",
    "check:all": "pnpm check && pnpm test:e2e"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5 <7",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.34.1"
}
